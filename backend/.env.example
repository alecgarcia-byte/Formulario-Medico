# ============================================================
# Variables de entorno del backend (copiar a .env y completar)
# NUNCA subir este archivo al repositorio. Usar para desarrollo local.
# ============================================================

# Base de datos. En producción: cadena de Supabase (pooler transacción).
# local dev (sin servidor): DATABASE_URL puede quedar vacío -> usa SQLite.
DATABASE_URL=

# Opcional (solo desarrollo/tests con SQLite): ruta del archivo SQLite.
# Si se omite, se usa ./formulario_local.db. Útil para aislar tests.
# SQLITE_PATH=./tests_local.db

# Entorno: development (default) o production.
# En production se deshabilita la documentación interactiva (/docs).
ENVIRONMENT=development

# Clave AES-256 para cifrar campos sensibles.
# Generar con:  openssl rand -base64 32
SECRET_KEY_AES=

# Secreto para firmar JWT (reservado; algunos flujos lo usan).
# Generar con:  openssl rand -hex 32
JWT_SECRET=

# ============================================================
# ACCESO AL PANEL ADMIN (sin login de usuario/contraseña)
# ============================================================
# ADMIN_TOKEN es la URL/llave secreta del panel. El panel se sirve en
# /admin-<ADMIN_TOKEN> y la API admin exige este token en la ruta.
# Generar (mín. 20 caracteres, recomendado 32+):
#   openssl rand -hex 32
ADMIN_TOKEN=

# URL del frontend estático (para CORS).
FRONTEND_URL=
